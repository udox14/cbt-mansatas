{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "lib": ["ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "jsxImportSource": "hono/jsx",
    "types": ["@cloudflare/workers-types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts"]
}
